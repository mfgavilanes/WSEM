digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad="0.2", nodesep="0.8"];
  node [shape=rect, style="rounded,filled", fontname="Arial", fontsize=15, margin="0.16,0.10"];
  teaches [label="ex:teaches\n(propiedad)", fillcolor="#E8F5E9", color="#3A7D44"];
  participates [label="ex:participatesInCourse\n(propiedad)", fillcolor="#E8F5E9", color="#3A7D44"];
  person [label="ex:Person\n(clase)", fillcolor="#FFF3CD", color="#B7791F"];
  marta [label="ex:Marta", shape=ellipse, fillcolor="#E7F0FA", color="#386FA4"];
  c1 [label="ex:C1", shape=ellipse, fillcolor="#E7F0FA", color="#386FA4"];
  teaches -> participates [label="rdfs:subPropertyOf", color="#386FA4"];
  participates -> person [label="rdfs:domain", color="#386FA4"];
  marta -> c1 [label="ex:teaches", color="#386FA4"];
}
