digraph G {
 graph [rankdir=LR, bgcolor="transparent", fontname="Arial", label="Resultado RDF de una vista", labelloc=t, fontsize=18];
 node [shape=box, style="rounded,filled", fillcolor="#E8F1FA", color="#2F6B8A", fontname="Arial"];
 edge [color="#346B8A", fontname="Arial", fontsize=11];
 subgraph cluster_source { label="dos coincidencias de origen"; color="#3C8DAD"; style="rounded"; s01 [label="student:s01"]; c02 [label="course:c02"]; c03 [label="course:c03"]; s01 -> c02 [label="ex:needsReview"]; s01 -> c03 [label="ex:needsReview"]; }
 subgraph cluster_result { label="una tripleta en CONSTRUCT"; color="#7A8D3C"; style="rounded"; pending [label="pending", shape=ellipse, fillcolor="#F6E8C3"]; s01 -> pending [label="ex:reviewStatus", color="#7A8D3C"]; }
}
