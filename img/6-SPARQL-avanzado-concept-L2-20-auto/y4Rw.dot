digraph G {
 graph [rankdir=LR, bgcolor="transparent", fontname="Arial", label="Matrículas por asignatura", labelloc=t, fontsize=18];
 node [shape=box, style="rounded,filled", fillcolor="#E8F1FA", color="#2F6B8A", fontname="Arial"];
 edge [color="#346B8A", fontname="Arial", fontsize=11];
 s01 [label="student:s01"]; s02 [label="student:s02"]; s03 [label="student:s03"]; c02 [label="course:c02"]; c03 [label="course:c03"];
 s01 -> c02 [label="ex:enrolledIn"]; s02 -> c02 [label="ex:enrolledIn"]; s03 -> c03 [label="ex:enrolledIn"];
}
