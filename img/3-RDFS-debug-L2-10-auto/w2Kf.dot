digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad="0.2", nodesep="0.8"];
  node [shape=rect, style="rounded,filled", fontname="Arial", fontsize=15, margin="0.16,0.10"];
  participates [label="ex:participatesInCourse\n(propiedad)", fillcolor="#FCE8E6", color="#B13D3D"];
  teaches [label="ex:teaches\n(propiedad)", fillcolor="#FCE8E6", color="#B13D3D"];
  ana [label="ex:Ana", shape=ellipse, fillcolor="#E7F0FA", color="#386FA4"];
  c1 [label="ex:C1", shape=ellipse, fillcolor="#E7F0FA", color="#386FA4"];
  participates -> teaches [label="rdfs:subPropertyOf (error)", color="#B13D3D"];
  ana -> c1 [label="ex:teaches", color="#386FA4"];
}
