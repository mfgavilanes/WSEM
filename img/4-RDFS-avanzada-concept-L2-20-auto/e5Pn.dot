      digraph G {
        graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.55", ranksep="0.8"];
        node [fontname="Arial", style="rounded,filled", fillcolor="#EAF2F8", color="#1F618D", fontcolor="#17202A", margin="0.12,0.08"];
        edge [fontname="Arial", color="#34495E", fontcolor="#17202A", arrowsize="0.75"];
        ines [label="ex:ines", shape=box];
teamA [label="ex:teamA", shape=box];
manager [label="ex:managerOf", shape=ellipse];
member [label="ex:memberOf", shape=ellipse];
employee [label="ex:Employee", shape=ellipse];
team [label="ex:Team", shape=ellipse];
        ines -> teamA [label="ex:managerOf"];
manager -> member [label="rdfs:subPropertyOf"];
member -> employee [label="rdfs:domain"];
member -> team [label="rdfs:range"];
      }
