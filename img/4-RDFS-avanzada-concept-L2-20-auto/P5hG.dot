      digraph G {
        graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.55", ranksep="0.8"];
        node [fontname="Arial", style="rounded,filled", fillcolor="#EAF2F8", color="#1F618D", fontcolor="#17202A", margin="0.12,0.08"];
        edge [fontname="Arial", color="#34495E", fontcolor="#17202A", arrowsize="0.75"];
        ai [label="ex:ai", shape=box];
ana [label="ex:ana", shape=box];
teaches [label="ex:teaches", shape=ellipse];
professor [label="ex:Professor", shape=ellipse];
        ai -> ana [label="ex:teaches"];
teaches -> professor [label="rdfs:domain"];
      }
