      digraph G {
        graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.55", ranksep="0.8"];
        node [fontname="Arial", style="rounded,filled", fillcolor="#EAF2F8", color="#1F618D", fontcolor="#17202A", margin="0.12,0.08"];
        edge [fontname="Arial", color="#34495E", fontcolor="#17202A", arrowsize="0.75"];
        paula [label="ex:paula", shape=box];
omar [label="ex:omar", shape=box];
advises [label="ex:advises", shape=ellipse];
collab [label="ex:collaboratesWith", shape=ellipse];
researcher [label="ex:Researcher", shape=ellipse];
        paula -> omar [label="ex:advises"];
advises -> collab [label="rdfs:subPropertyOf"];
collab -> researcher [label="rdfs:range"];
      }
