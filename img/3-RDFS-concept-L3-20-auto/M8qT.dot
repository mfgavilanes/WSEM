digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.7"];
  node [shape=rect, style="rounded,filled", fillcolor="#EAF3FF", color="#386FA4", fontname="Arial", fontsize=15, margin="0.16,0.10"];
  edge [color="#386FA4", fontname="Arial", fontsize=14, penwidth=1.5];
  x [label="ex:x", shape=ellipse];
  c [label="ex:c", shape=ellipse];
  property [label="ex:enrolledIn\\n(propiedad)", fillcolor="#E8F5E9", color="#3A7D44"];
  student [label="ex:Student\\n(clase)", fillcolor="#FFF3CD", color="#B7791F"];
  person [label="ex:Person\\n(clase)", fillcolor="#FFF3CD", color="#B7791F"];
  x -> c [label="ex:enrolledIn"];
  property -> student [label="rdfs:domain"];
  student -> person [label="rdfs:subClassOf"];
}
