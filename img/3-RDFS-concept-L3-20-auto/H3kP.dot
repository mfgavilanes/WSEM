digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.7"];
  node [shape=rect, style="rounded,filled", fillcolor="#FFF3CD", color="#B7791F", fontname="Arial", fontsize=15, margin="0.16,0.10"];
  edge [color="#B7791F", fontname="Arial", fontsize=14, penwidth=1.5];
  ana [label="ex:Ana", shape=ellipse, fillcolor="#E7F0FA", color="#386FA4"];
  ta [label="ex:TeachingAssistant\\n(clase)"];
  student [label="ex:Student\\n(clase)"];
  person [label="ex:Person\\n(clase)"];
  ana -> ta [label="rdf:type", color="#386FA4"];
  ta -> student [label="rdfs:subClassOf"];
  student -> person [label="rdfs:subClassOf"];
}
