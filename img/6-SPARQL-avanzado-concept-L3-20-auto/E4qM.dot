digraph G {
 graph [rankdir=LR, bgcolor="transparent", fontname="Arial", label="Información combinada de dos grafos", labelloc=t, fontsize=18];
 node [shape=box, style="rounded,filled", fillcolor="#E8F1FA", color="#2F6B8A", fontname="Arial"]; edge [color="#346B8A", fontname="Arial", fontsize=11];
 subgraph cluster_a { label="urn:graph:academic"; color="#3C8DAD"; style="rounded"; s01 [label="student:s01"]; s02 [label="student:s02"]; c02 [label="course:c02"]; c03 [label="course:c03"]; s01 -> c02 [label="ex:enrolledIn"]; s02 -> c03 [label="ex:enrolledIn"]; }
 subgraph cluster_r { label="urn:graph:research"; color="#7A8D3C"; style="rounded"; p01 [label="project:p01"]; p01 -> s01 [label="ex:hasMember"]; }
}
