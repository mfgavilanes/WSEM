digraph G {
 graph [rankdir=LR, bgcolor="transparent", fontname="Arial", label="Estado administrativo opcional", labelloc=t, fontsize=18]; node [shape=box, style="rounded,filled", fillcolor="#E8F1FA", color="#2F6B8A", fontname="Arial"]; edge [color="#346B8A", fontname="Arial", fontsize=11]; subgraph cluster_a { label="urn:graph:academic"; color="#3C8DAD"; style="rounded"; s01 [label="student:s01"]; s02 [label="student:s02"]; } subgraph cluster_ad { label="urn:graph:administrative"; color="#7A8D3C"; style="rounded"; active [label="active", shape=ellipse, fillcolor="#F6E8C3"]; s01 -> active [label="ex:administrativeStatus"]; }
}
