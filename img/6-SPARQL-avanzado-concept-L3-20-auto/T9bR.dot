digraph G {
 graph [rankdir=LR, bgcolor="transparent", fontname="Arial", label="Matrícula, prerrequisitos y aprobados", labelloc=t, fontsize=18];
 node [shape=box, style="rounded,filled", fillcolor="#E8F1FA", color="#2F6B8A", fontname="Arial"]; edge [color="#346B8A", fontname="Arial", fontsize=11];
 s01 [label="student:s01"]; c03 [label="course:c03"]; c02 [label="course:c02"]; c01 [label="course:c01"]; s01 -> c03 [label="ex:enrolledIn"]; c03 -> c02 [label="ex:hasPrerequisite"]; c02 -> c01 [label="ex:hasPrerequisite"]; s01 -> c02 [label="ex:passed", color="#7A8D3C"];
}
