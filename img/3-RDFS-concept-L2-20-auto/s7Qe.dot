digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.55", ranksep="0.7"];
  node [shape=ellipse, style="filled", fillcolor="#FFF4D6", color="#B7791F", fontname="Arial"];
