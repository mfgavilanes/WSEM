digraph G { graph [rankdir=LR, bgcolor="transparent", label="Dos coincidencias y una tripleta derivada", labelloc=t]; node [shape=box, style="rounded,filled", fillcolor="#E8F1FA"]; s01 [label="student:s01"]; c02 [label="course:c02"]; c03 [label="course:c03"]; pending [label="pending", shape=ellipse]; s01 -> c02 [label="ex:needsReview"]; s01 -> c03 [label="ex:needsReview"]; s01 -> pending [label="ex:reviewStatus", color="#7A8D3C"]; }
