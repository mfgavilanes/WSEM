digraph G {
 graph [rankdir=LR, bgcolor="transparent", fontname="Arial", label="Vista RDF de revisión", labelloc=t, fontsize=18]; node [shape=box, style="rounded,filled", fillcolor="#E8F1FA", color="#2F6B8A", fontname="Arial"]; edge [color="#346B8A", fontname="Arial", fontsize=11]; subgraph cluster_source { label="datos de origen"; color="#3C8DAD"; style="rounded"; s01 [label="student:s01"]; c03 [label="course:c03"]; c01 [label="course:c01"]; s01 -> c03 [label="ex:enrolledIn"]; c03 -> c01 [label="ex:hasPrerequisite"]; } subgraph cluster_view { label="resultado CONSTRUCT"; color="#7A8D3C"; style="rounded"; s01 -> c01 [label="ex:needsPrerequisiteReview", color="#7A8D3C"]; }
}
