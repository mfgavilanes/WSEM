digraph m4KD {
  graph [rankdir=LR, bgcolor="transparent", margin=0.05, nodesep=0.35, ranksep=0.6];
  node [fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=10];
  Ana [shape=ellipse, label="ex:Ana"];
  B1 [shape=ellipse, label="_:b1"];
  Ourense [shape=box, style="rounded,dashed", label="\"Ourense\""];
  Zip [shape=box, style="rounded,dashed", label="\"32001\""];
  Ana -> B1 [label="ex:address"];
  B1 -> Ourense [label="ex:city"];
  B1 -> Zip [label="ex:zip"];
}