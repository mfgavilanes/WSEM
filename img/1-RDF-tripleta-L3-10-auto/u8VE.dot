digraph u8VE {
  graph [rankdir=TB, bgcolor="transparent", margin=0.05, nodesep=0.45, ranksep=0.55];
  node [fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=10];

  subgraph clusterA {
    label="Grafo A";
    color="gray70";
    A_Ana [shape=ellipse,label="ex:Ana"];
    A_b [shape=ellipse,label="_:b1"];
    A_City [shape=box,style="rounded,dashed",label="\"Ourense\""];
    A_Ana -> A_b [label="ex:address"];
    A_b -> A_City [label="ex:city"];
  }

  subgraph clusterB {
    label="Grafo B";
    color="gray70";
    B_Ana [shape=ellipse,label="ex:Ana"];
    B_b [shape=ellipse,label="_:x9"];
    B_City [shape=box,style="rounded,dashed",label="\"Ourense\""];
    B_Ana -> B_b [label="ex:address"];
    B_b -> B_City [label="ex:city"];
  }
}