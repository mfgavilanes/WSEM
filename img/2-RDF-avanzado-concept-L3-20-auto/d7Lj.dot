digraph d7Lj {
  graph [rankdir=LR, bgcolor="transparent", pad="0.15", newrank=true];
  node [shape=box, style="rounded,filled", fillcolor="#E8F1FF", color="#3D6FB6", fontname="Arial"];
  edge [color="#4C6078", fontname="Arial"];
  subgraph cluster_a {
    label="Modelo A";
    color="#9CB7DD";
    a1 [label="course:c01"]; a2 [label="course:c02"];
    shared [shape=ellipse, label="_:x", fillcolor="#FFF4D6", color="#B57B00"];
    va [label="\"Proyecto\"", fillcolor="#F3F3F3", color="#7C7C7C"];
    a1 -> shared [label="ex:hasEvaluation"];
    a2 -> shared [label="ex:hasEvaluation"];
    shared -> va [label="rdf:value"];
  }
  subgraph cluster_b {
    label="Modelo B";
    color="#9CB7DD";
    b1 [label="course:c01"]; b2 [label="course:c02"];
    bx [shape=ellipse, label="_:y", fillcolor="#FFF4D6", color="#B57B00"];
    bz [shape=ellipse, label="_:z", fillcolor="#FFF4D6", color="#B57B00"];
    vb1 [label="\"Proyecto\"", fillcolor="#F3F3F3", color="#7C7C7C"];
    vb2 [label="\"Proyecto\"", fillcolor="#F3F3F3", color="#7C7C7C"];
    b1 -> bx [label="ex:hasEvaluation"];
    b2 -> bz [label="ex:hasEvaluation"];
    bx -> vb1 [label="rdf:value"];
    bz -> vb2 [label="rdf:value"];
  }
}
