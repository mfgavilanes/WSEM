digraph W1mZ {
  graph [rankdir=LR, bgcolor="transparent", pad="0.15"];
  node [shape=ellipse, style="filled", fillcolor="#FFF4D6", color="#B57B00", fontname="Arial"];
  edge [color="#4C6078", fontname="Arial"];
  l1 [label="_:l1"]; l2 [label="_:l2"]; l3 [label="_:l3"]; l4 [label="_:l4"]; nil [label="rdf:nil"];
