digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.55", ranksep="0.8"];
  node [shape=box, style="rounded", fontname="Arial"];
  edge [fontname="Arial"];
  d [label="degree:AI"];
  n [label="Artificial Intelligence", shape=ellipse];
  s1 [label="student:s01"];
  s2 [label="student:s02"];
  d -> n [label="rdfs:label"];
  s1 -> d [label="ex:studiesDegree"];
  s2 -> d [label="ex:studiesDegree"];
}
