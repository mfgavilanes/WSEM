    courseA [label="course:c01"];
    blankA [shape=ellipse, label="_:x1", fillcolor="#FFF4D6", color="#B57B00"];
    valueA [label="\"Proyecto\"", fillcolor="#F3F3F3", color="#7C7C7C"];
    courseA -> blankA [label="ex:hasEvaluation"];
    blankA -> valueA [label="rdf:value"];
  }
  subgraph cluster_b {
    label="Modelo B";
