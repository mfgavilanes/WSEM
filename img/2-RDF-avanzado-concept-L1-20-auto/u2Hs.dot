digraph u2Hs {
  graph [rankdir=LR, bgcolor="transparent", pad="0.15"];
  node [shape=box, style="rounded,filled", fillcolor="#E8F1FF", color="#3D6FB6", fontname="Arial"];
  edge [color="#4C6078", fontname="Arial"];
  ana [label="student:ana\nAna"];
  diego [label="student:diego\nDiego"];
  course [label="course:c01\nWeb Semántica"];
  ana -> course [label="ex:enrolledIn"];
  diego -> course [label="ex:enrolledIn"];
}
