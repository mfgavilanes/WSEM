d [label="ex:data1", shape=box];
rt [label="ex:relatedTo", shape=ellipse];
da [label="ex:Dataset", shape=ellipse];
pr [label="ex:PublicResource", shape=ellipse];
re [label="ex:Resource", shape=ellipse];
      s -> d [label="ex:relatedTo"];
