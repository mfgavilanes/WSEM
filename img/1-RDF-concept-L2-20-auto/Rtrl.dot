digraph Rtrl {
  graph [rankdir=LR, bgcolor="transparent", margin=0.05];
  node [fontname="Arial", fontsize=12];
  edge [fontname="Arial", fontsize=11];
  Course [shape=ellipse, label="ex:WebSemantica"];
  Label [shape=box, style="rounded,dashed", label="\"Web Semántica\""];
  Credits [shape=box, style="rounded,dashed", label="6"];
  Course -> Label [label="rdfs:label"];
  Course -> Credits [label="ex:credits"];
}